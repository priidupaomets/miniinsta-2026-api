# Kopeerige see fail nimega .env ja täitke parool. .env EI lähe Gitti.
PORT=3000

# SQL Server (Dockeri server: localhost ja port 1433)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=MiniInsta2026
DB_USER=appuser
DB_PASSWORD=

# Windowsi nimega eksemplar (SQL Server Express):
#   DB_SERVER=localhost\SQLEXPRESS
#   ja jätke DB_PORT täitmata

# Mõõtmine (8. loeng). 1 = logisse ka loetud lehekülgede arv (SET STATISTICS IO ON).
STATS_IO=0

