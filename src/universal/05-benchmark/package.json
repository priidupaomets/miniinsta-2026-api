{
  "name": "miniinsta-universal",
  "version": "5.0.0",
  "description": "MiniInsta API, step 5: measuring. Database engine chosen in .env (mssql, mysql, postgres, sqlite)",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "bench": "node bench.js",
    "sqlite:create": "node create-sqlite.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.1.0",
    "hbs": "^4.2.0",
    "mssql": "^12.0.0",
    "mysql2": "^3.15.0",
    "pg": "^8.16.0"
  }
}
