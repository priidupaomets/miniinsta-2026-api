# Copy this file as .env and fill in the password. .env does NOT go to Git.
PORT=3000

# Database engine: mssql | mysql | postgres | sqlite
DB_ENGINE=mssql

# Server (mssql, mysql, postgres). Empty DB_PORT = the engine's default port: 1433, 3306, 5432
DB_SERVER=localhost
DB_PORT=
DB_NAME=MiniInsta2026
DB_USER=appuser
DB_PASSWORD=

# MS SQL on Windows with a named instance (SQL Server Express):
#   DB_SERVER=localhost\SQLEXPRESS   and leave DB_PORT empty

# SQLite: the database is a file. Create it with  npm run sqlite:create  (see README)
DB_FILE=./MiniInsta2026.db

# Measuring. 1 = also the number of pages read in the log (SET STATISTICS IO ON). mssql only.
STATS_IO=0

# Examples
#   MySQL:       DB_ENGINE=mysql     DB_PORT=3306  DB_NAME=MiniInsta2026
#   PostgreSQL:  DB_ENGINE=postgres  DB_PORT=5432  DB_NAME=miniinsta2026
#   Big database: DB_NAME=MiniInsta2026Big (mssql, mysql), miniinsta2026big (postgres),
#                 DB_FILE=<path>/MiniInsta2026Big.db (sqlite)
